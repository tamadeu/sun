A = [11, 12, 13, 14; 21, 22, 23, 24; 31, 32, 33, 34];

disp("Ultima linha, primeira coluna:");
disp(A(end, 1));

disp("Primeira linha, ultima coluna:");
disp(A(1, end));

disp("Penultima linha, penultima coluna:");
disp(A(end - 1, end - 1));

A(end, end) = 99;
disp("Apos alterar o ultimo elemento:");
disp(A);

B = [1; 2];
disp("Indice aninhado:");
disp(A(B(end, 1) + end - 2, end));

try
    A(end + 1, 1) = 0;
catch erro
    disp(erro.identifier);
end