total = 0;
for indice = 1:5
    total = total + indice;
end
disp("Soma de 1 a 5:");
disp(total);

disp("Contagem regressiva:");
for indice = 3:-1:1
    disp(indice);
end

disp("Passo fracionario:");
for valor = 0:0.1:0.3
    disp(valor);
end

total = 0;
for indice = 1:10
    if indice == 3
        continue;
    elseif indice == 7
        break;
    end
    total = total + indice;
end
disp("Soma com saltos:");
disp(total);

matriz = [0, 0, 0; 0, 0, 0];
for linha = 1:2
    for coluna = 1:3
        matriz(linha, coluna) = linha * 10 + coluna;
    end
end
disp("Matriz preenchida:");
disp(matriz);